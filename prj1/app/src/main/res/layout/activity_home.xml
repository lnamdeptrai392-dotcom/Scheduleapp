<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DEC5C5">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardHeader"
        android:layout_width="376dp"
        android:layout_height="110dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardBell"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F0F0F0">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_bell" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/schedule"
            android:textColor="#F86161"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"/>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardCalendar"
        android:layout_width="264dp"
        android:layout_height="225dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardHeader"
        app:layout_constraintEnd_toEndOf="parent">

        <CalendarView
            android:id="@+id/calendarView"
            android:layout_width="match_parent"
            android:layout_height="228dp" />
    </androidx.cardview.widget.CardView>
    <!-- ADD -->
    <Button
        android:id="@+id/addSchedule"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/add"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardCalendar"
        app:layout_constraintTop_toTopOf="@id/cardCalendar"
        app:layout_constraintBottom_toTopOf="@id/searchEvent"
        app:layout_constraintVertical_chainStyle="spread" />
    <!-- SEARCH -->
    <Button
        android:id="@+id/searchEvent"
        android:layout_width="0dp"
        android:layout_height="67dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardCalendar"
        app:layout_constraintTop_toBottomOf="@id/addSchedule"
        app:layout_constraintBottom_toTopOf="@id/DeleteEvent" />

    <!-- DELETE -->
    <Button
        android:id="@+id/DeleteEvent"
        android:layout_width="0dp"
        android:layout_height="67dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/delete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardCalendar"
        app:layout_constraintTop_toBottomOf="@id/searchEvent"
        app:layout_constraintBottom_toBottomOf="@id/cardCalendar" />

    <androidx.cardview.widget.CardView
        android:layout_width="375dp"
        android:layout_height="335dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/cardCalendar" >

        <TextView
            android:id="@+id/tvTitle2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartof="parent"
            app:layout_constraintTop_toTopof="parent"

            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:text="@string/today_schedule2"
            android:textColor="#F86161"
            android:textSize="25sp"
            android:textStyle="bold" />

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
